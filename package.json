{
  "name": "bbbpump",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "static": "NEXT_PUBLIC_IS_MOBILE=true next build",
    "cap:add": "npx cap add ios && npx cap add android",
    "cap:sync": "yarn static && npx cap sync",
    "ios": "npx cap open ios",
    "android": "npx cap open android",
    "android:build:aab": "yarn cap:sync && cd android && ./gradlew bundleRelease",
    "android:build:apk": "yarn cap:sync && cd android && ./gradlew assembleRelease",
    "android:build": "yarn android:build:aab && yarn android:build:apk",
    "release:copy": "mkdir -p release && VERSION=$(grep versionName android/app/build.gradle | cut -d'\"' -f2) && cp android/app/build/outputs/bundle/release/app-release.aab release/BBBFI-$VERSION.aab && cp android/app/build/outputs/apk/release/app-release.apk release/BBBFI-$VERSION.apk",
    "release:copy:apk": "mkdir -p release && VERSION=$(grep versionName android/app/build.gradle | cut -d'\"' -f2) && cp android/app/build/outputs/apk/release/app-release.apk release/BBBFI-$VERSION.apk",
    "generate:icons": "npx capacitor-assets generate",
    "build:apk": "yarn generate:icons && yarn android:build:apk && yarn release:copy:apk",
    "build:all": "yarn generate:icons && yarn android:build && yarn release:copy"
  },
  "dependencies": {
    "@bigmi/react": "^0.3.1",
    "@capacitor/android": "^6.2.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@lifi/widget": "^3.23.3",
    "@mysten/dapp-kit": "^0.16.12",
    "@privy-io/react-auth": "1.98.4",
    "@privy-io/wagmi": "0.2.13",
    "@rainbow-me/rainbowkit": "2",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/web3.js": "^1.95.8",
    "@tanstack/react-query": "^5.80.10",
    "@vercel/analytics": "^1.3.1",
    "@vercel/speed-insights": "^1.0.12",
    "copy-to-clipboard": "^3.3.3",
    "lightweight-charts": "^4.2.0",
    "merkletreejs": "^0.4.0",
    "nanoid": "^4.0.0",
    "next": "^14.2.14",
    "qrcode.react": "^4.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "viem": "^2.21.53",
    "wagmi": "^2.15.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "autoprefixer": "^10.4.20",
    "cssnano": "^7.0.6",
    "daisyui": "^4.12.13",
    "eslint": "8",
    "eslint-config-next": "^14.2.14",
    "null-loader": "^4.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
